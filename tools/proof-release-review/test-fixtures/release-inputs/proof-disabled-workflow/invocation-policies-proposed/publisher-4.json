    },
    {
      "Sid": "DenyWrongOrMissingEncryption",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    },
    {
      "Sid": "DenyCopy",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "*",
      "Condition": {
        "Null": {
          "s3:x-amz-copy-source": "false"
        }
      }
    },
    {
      "Sid": "AllowConditionalIndexReplace",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::example-proof-fixture/index.html"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        },
        "StringEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        },
        "StringNotEquals": {
          "s3:if-match": [
            "",
            "*"
          ]
        },
        "Null": {
          "s3:if-match": "false",
          "s3:if-none-match": "true",
          "s3:x-amz-copy-source": "true"
        }
      }
    },
    {
      "Sid": "DenyMissingIndexMatch",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::example-proof-fixture/index.html"
      ],
      "Condition": {
        "Null": {
          "s3:if-match": "true"
        }
      }
    },
    {
      "Sid": "DenyEmptyOrWildcardIndexMatch",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::example-proof-fixture/index.html"
      ],
      "Condition": {
        "StringEquals": {
          "s3:if-match": [
            "",
            "*"
          ]
        }
      }
    },
    {
      "Sid": "DenyIfNoneMatchOnIndex",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::example-proof-fixture/index.html"
      ],
      "Condition": {
        "Null": {
          "s3:if-none-match": "false"
        }
      }
    }
