{
  "output_template_id": "template-lift-ecommerce-orders",
  "name": "Lift E-commerce Orders",
  "destination_method": "HTTP POST",
  "output_format": "JSON",
  "body_template": "{\n  \"customer\": {\n    \"lift_customer_id\": \"{{customer.destination_customer_id}}\",\n    \"customer_name\": \"{{customer.customer_name}}\",\n    \"crm_id\": \"{{customer.crm_id}}\"\n  },\n  \"contacts\": [\n    {\n      \"first_name\": \"{{contacts[].first_name}}\",\n      \"last_name\": \"{{contacts[].last_name}}\",\n      \"title\": \"{{contacts[].title}}\",\n      \"email\": \"{{contacts[].email}}\",\n      \"mobile_phone\": \"{{contacts[].mobile_phone}}\",\n      \"office_phone\": \"{{contacts[].office_phone}}\",\n      \"home_phone\": \"{{contacts[].home_phone}}\",\n      \"slack\": \"{{contacts[].slack}}\",\n      \"fax\": \"{{contacts[].fax}}\"\n    }\n  ],\n  \"source\": {\n    \"platform\": \"Pathfinder\",\n    \"pathfinder_customer_id\": \"{{customer.customer_id}}\",\n    \"source_system\": \"{{source.source_system}}\",\n    \"source_customer\": \"{{source.source_customer}}\",\n    \"source_record_id\": \"{{source.source_record_id}}\",\n    \"source_record_url\": \"{{source.source_record_url}}\",\n    \"source_template\": \"{{source.source_template}}\",\n    \"submitted_at\": \"{{source.submitted_at}}\",\n    \"pathfinder_job_id\": \"{{generated.pathfinder_job_id}}\",\n    \"pathfinder_canonical_order_id\": \"{{generated.pathfinder_canonical_order_id}}\",\n    \"schema\": \"{{source.schema}}\",\n    \"integration_id\": \"{{source.integration_id}}\",\n    \"store\": \"{{source.store}}\",\n    \"created_at\": \"{{source.created_at}}\"\n  },\n  \"order\": {\n    \"ext_id\": \"{{order.external_order_id}}\",\n    \"po_number\": \"{{order.po_number}}\",\n    \"contract_number\": \"{{order.contract_number}}\",\n    \"order_title\": \"{{order.order_title}}\",\n    \"order_note\": \"{{order.order_note}}\",\n    \"requested_ship_date\": \"{{order.ship_date}}\",\n    \"due_date\": \"{{order.due_date}}\",\n    \"order_attachment\": \"{{order.order_attachment}}\",\n    \"artwork_folder_url\": \"{{order.artwork_folder_url}}\",\n    \"reference_proof_url\": \"{{order.reference_proof_url}}\",\n    \"shipping\": {\n      \"method\": \"{{order.shipping.method}}\",\n      \"account_number\": \"{{order.shipping.account_number}}\",\n      \"acct_billing_zip\": \"{{order.shipping.acct_billing_zip}}\",\n      \"acct_billing_country\": \"{{order.shipping.acct_billing_country}}\",\n      \"attention_to\": \"{{order.shipping.attention_to}}\",\n      \"company\": \"{{order.shipping.company}}\",\n      \"address_1\": \"{{order.shipping.address_1}}\",\n      \"address_2\": \"{{order.shipping.address_2}}\",\n      \"city\": \"{{order.shipping.city}}\",\n      \"state\": \"{{order.shipping.state}}\",\n      \"postal_code\": \"{{order.shipping.postal_code}}\",\n      \"country\": \"{{order.shipping.country}}\",\n      \"phone\": \"{{order.shipping.phone}}\",\n      \"email\": \"{{order.shipping.email}}\",\n      \"instructions\": \"{{order.shipping.instructions}}\"\n    },\n    \"shipping_policy\": {\n      \"prepaid_label_url\": \"{{order.document_delivery.prepaid_label_url}}\",\n      \"prepaid_label_supplied\": \"{{order.shipping_policy.prepaid_label_supplied}}\",\n      \"mode\": \"{{order.shipping_policy.mode}}\",\n      \"blind_ship\": \"{{order.shipping_policy.blind_ship}}\",\n      \"ship_from_name\": \"{{order.shipping_policy.ship_from_name}}\",\n      \"label_precedence\": \"{{order.shipping_policy.label_precedence}}\",\n      \"missing_ship_date\": \"{{order.shipping_policy.missing_ship_date}}\"\n    },\n    \"order_type_name\": \"{{order.order_type_name}}\",\n    \"market\": \"{{order.market}}\",\n    \"priority\": \"{{order.priority}}\"\n  },\n  \"lines\": [\n    {\n      \"line_number\": \"{{lines[].line_number}}\",\n      \"unit_number\": \"{{lines[].unit_number}}\",\n      \"customer_sku\": \"{{lines[].customer_sku}}\",\n      \"description\": \"{{lines[].description}}\",\n      \"product_id\": \"{{lines[].product_id}}\",\n      \"product_name\": \"{{lines[].product_name}}\",\n      \"quantity\": \"{{lines[].quantity}}\",\n      \"artwork\": {\n        \"file_name\": \"{{lines[].artwork.file_name}}\",\n        \"file_url\": \"{{lines[].artwork.file_url}}\",\n        \"checksum\": \"{{lines[].artwork.checksum}}\",\n        \"format\": \"{{lines[].source_line.artwork.format}}\",\n        \"pages\": \"{{lines[].source_line.artwork.pages}}\",\n        \"bytes\": \"{{lines[].source_line.artwork.bytes}}\",\n        \"page_in\": {\n          \"w\": \"{{lines[].source_line.artwork.page_in.w}}\",\n          \"h\": \"{{lines[].source_line.artwork.page_in.h}}\"\n        },\n        \"trim_in\": {\n          \"w\": \"{{lines[].source_line.artwork.trim_in.w}}\",\n          \"h\": \"{{lines[].source_line.artwork.trim_in.h}}\"\n        }\n      },\n      \"dimensions\": {\n        \"final_height\": \"{{lines[].dimensions.final_height}}\",\n        \"final_width\": \"{{lines[].dimensions.final_width}}\",\n        \"live_height\": \"{{lines[].dimensions.live_height}}\",\n        \"live_width\": \"{{lines[].dimensions.live_width}}\",\n        \"bleed\": \"{{lines[].dimensions.bleed}}\",\n        \"unit\": \"{{lines[].source_line.dimensions_unit}}\"\n      },\n      \"production\": {\n        \"material\": \"{{lines[].production.material}}\",\n        \"laminate\": \"{{lines[].production.laminate}}\",\n        \"coating\": \"{{lines[].production.coating}}\",\n        \"premask\": \"{{lines[].production.premask}}\",\n        \"ink\": \"{{lines[].production.ink}}\",\n        \"cut_type\": \"{{lines[].production.cut_type}}\",\n        \"material_code\": \"{{lines[].production.material_code}}\",\n        \"finish\": \"{{lines[].production.finish}}\",\n        \"shape\": \"{{lines[].production.shape}}\"\n      },\n      \"line_note\": \"{{lines[].line_note}}\",\n      \"preview\": {\n        \"file_url\": \"{{lines[].document_delivery.preview_url}}\",\n        \"format\": \"{{lines[].source_line.preview.format}}\",\n        \"purpose\": \"{{lines[].source_line.preview.purpose}}\"\n      },\n      \"external_line_id\": \"{{lines[].source_line.external_line_id}}\",\n      \"store_product\": \"{{lines[].source_line.store_product}}\",\n      \"store_variation_id\": \"{{lines[].source_line.store_variation_id}}\",\n      \"cut\": {\n        \"type\": \"{{lines[].source_line.cut.type}}\",\n        \"method\": \"{{lines[].source_line.cut.method}}\",\n        \"spot_name\": \"{{lines[].source_line.cut.spot_name}}\",\n        \"layer_name\": \"{{lines[].source_line.cut.layer_name}}\",\n        \"in_file\": \"{{lines[].source_line.cut.in_file}}\"\n      },\n      \"approval\": {\n        \"provider\": \"{{lines[].source_line.approval.provider}}\",\n        \"approved_by\": \"{{lines[].source_line.approval.approved_by}}\",\n        \"approved_at\": \"{{lines[].source_line.approval.approved_at}}\",\n        \"artwork_sha256\": \"{{lines[].source_line.approval.artwork_sha256}}\"\n      },\n      \"area\": {\n        \"value\": \"{{lines[].source_line.area.value}}\",\n        \"unit\": \"{{lines[].source_line.area.unit}}\",\n        \"basis\": \"{{lines[].source_line.area.basis}}\"\n      }\n    }\n  ]\n}",
  "header_template": "{\n  \"Content-Type\": \"application/json\",\n  \"Ext_ID\": \"{{order.external_order_id}}\",\n  \"User\": \"{{environment.credentials.User}}\",\n  \"Password\": \"{{environment.credentials.Password}}\",\n  \"Company\": \"{{environment.headers.Company}}\"\n}",
